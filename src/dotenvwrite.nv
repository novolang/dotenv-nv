// dotenvwrite.nv — rendering a `.env` document, and changing one line of
// it.
//
// Every row is `[]`.
//
// A `.env` file is edited by people.  It has comments that explain a
// value, blank lines between sections, and commented-out overrides kept
// for later.  The writer therefore works on a `DotenvDocument`, which
// keeps every line, and changes only the line it is asked to.  A line
// nobody changed is rendered as the text it was parsed from, so
// `render(parse_document(text))` is `text` for every file a parse
// accepts.
//
// A line the writer does change is rendered from its fields.  The form
// is the narrowest one that reads back as the same value: bare where
// nothing needs quoting, single quotes where a `$` or a backslash must
// stay literal, and double quotes where there is a newline or a single
// quote.  A value always written in double quotes would turn a literal
// `$HOME` into a reference on the next read.

use std.str
use std.list
use dotenvparse

// A document rendered back to text.
//
// A document from `dotenvparse.parse_document` that nobody changed
// renders as the text it came from.
//
// ```novo
// use dotenvparse
// use dotenvwrite
//
// fn main() [io]
//     match dotenvparse.parse_document("# db\nHOST=localhost\n", dotenvparse.default_options())
//         Ok(d)  => print(dotenvwrite.render(d))
//         Err(e) => println(e.message())
// ```
pub fn render(d: DotenvDocument) -> Str []
    if list.len(d.lines) == 0
        return ""
    let body = d.lines |> list.map(l => line_text(l)) |> str.join("\n")
    var out = str.replace_all(body, "\n", d.newline)
    if d.final_newline
        out = out + d.newline
    out

// One entry as a line: the text it was parsed from when it has one, and
// otherwise `KEY=value` in its own form, with `export ` in front when
// the entry carries the prefix.
pub fn render_entry(e: DotenvEntry) -> Str []
    if e.written != ""
        return e.written
    var prefix = ""
    if e.exported
        prefix = "export "
    "${prefix}${e.key}=${written_value(e.value, e.quoting)}"

// A whole file from a list of pairs, one line each, every value in the
// narrowest form that reads back as itself.
pub fn render_pairs(pairs: [(Str, Str)]) -> Str []
    pairs
        |> list.map(pr => render_entry(dotenvparse.entry_quoted(pr.0, pr.1, quoting_for(pr.1))) + "\n")
        |> str.join("")

// A document with a key's value set, every other line left alone.
//
// The last assignment to the key is replaced, because it is the one in
// effect.  It keeps its `export` prefix, and keeps its form when that
// form can hold the new value; otherwise the form is `quoting_for`'s.
// A key the document does not assign is appended.  A key that is not a
// legal name is `DotenvBadKey` with line 0.
//
// ```novo
// use dotenvparse
// use dotenvwrite
//
// fn main() [io]
//     match dotenvparse.parse_document("# mail\nPORT=25\n", dotenvparse.default_options())
//         Ok(d)  =>
//             match dotenvwrite.set(d, "PORT", "2525")
//                 Ok(d2) => print(dotenvwrite.render(d2))
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn set(d: DotenvDocument, key: Str, value: Str) -> Result<DotenvDocument, DotenvFault> []
    let assigned = dotenvparse.entries_of(d) |> list.filter(e => e.key == key)
    match list.last(assigned)
        Some(old) => set_quoted(d, key, value, old.quoting)
        None      => set_quoted(d, key, value, quoting_for(value))

// A document with a key's value set in a chosen form.
//
// As `set`, except that the form is the caller's.  A value the form
// cannot hold, a single quote inside single quotes or anything needing
// quotes when bare, is written double-quoted instead.
pub fn set_quoted(d: DotenvDocument, key: Str, value: Str,
                  quoting: DotenvQuoting) -> Result<DotenvDocument, DotenvFault> []
    if not dotenvparse.key_is_valid(key)
        return Err(DotenvBadKey(0, key))
    let form = kept_form(quoting, value)
    let assigned = dotenvparse.entries_of(d) |> list.filter(e => e.key == key)
    match list.last(assigned)
        None      => Ok(append(d, dotenvparse.entry_quoted(key, value, form)))
        Some(old) =>
            let e = DotenvEntry { key: key, value: value, quoting: form,
                exported: old.exported, line: old.line, written: "" }
            Ok(with_lines(d, with_line_at(d.lines, last_assignment(d, key), DotenvAssignmentLine(e))))

// A document with every assignment to a key removed.
//
// The comments around it stay, since a comment above a value often
// describes the section rather than the line.  A key the document does
// not assign leaves it as it was.
pub fn unset(d: DotenvDocument, key: Str) -> Result<DotenvDocument, DotenvFault> []
    if not dotenvparse.key_is_valid(key)
        return Err(DotenvBadKey(0, key))
    Ok(with_lines(d, list.filter(d.lines, l => not assigns(l, key))))

// A document with every assignment to a key turned into a comment.
//
// Each line of the assignment gains `# ` in front, which is what a
// person does to disable a value and keep it for later.  A key the
// document does not assign leaves it as it was.
pub fn comment_out(d: DotenvDocument, key: Str) -> Result<DotenvDocument, DotenvFault> []
    if not dotenvparse.key_is_valid(key)
        return Err(DotenvBadKey(0, key))
    var lines: [DotenvLine] = []
    for l in d.lines
        if let DotenvAssignmentLine(e) = l
            if e.key == key
                for part in str.split(render_entry(e), "\n")
                    list.push(lines, DotenvCommentLine("# " + part))
                continue
        list.push(lines, l)
    Ok(with_lines(d, lines))

// A document with a comment line added above the last assignment to a
// key.
//
// A comment that does not begin with `#` gains `# ` in front.  A key the
// document does not assign leaves it as it was.
pub fn annotate(d: DotenvDocument, key: Str, comment: Str) -> Result<DotenvDocument, DotenvFault> []
    if not dotenvparse.key_is_valid(key)
        return Err(DotenvBadKey(0, key))
    let last = last_assignment(d, key)
    var lines: [DotenvLine] = []
    for i in 0..list.len(d.lines)
        if i == last
            list.push(lines, DotenvCommentLine(comment_text(comment)))
        list.push(lines, d.lines[i])
    Ok(with_lines(d, lines))

// A document with no lines, `\n` endings and a final newline.
pub fn empty_document() -> DotenvDocument []
    DotenvDocument { lines: [], newline: "\n", final_newline: true }

// A document with an assignment added at the end.
pub fn append(d: DotenvDocument, e: DotenvEntry) -> DotenvDocument []
    appended(d, DotenvAssignmentLine(e))

// A document with a comment line added at the end.  A comment that does
// not begin with `#` gains `# ` in front.
pub fn append_comment(d: DotenvDocument, text: Str) -> DotenvDocument []
    appended(d, DotenvCommentLine(comment_text(text)))

// A document with an empty line added at the end.
pub fn append_blank(d: DotenvDocument) -> DotenvDocument []
    appended(d, DotenvBlankLine(""))

// The narrowest form that reads back as this value.
//
// Bare when nothing in it needs quoting.  Double-quoted when it holds a
// line break, a tab or a single quote.  Single-quoted otherwise, which
// keeps a `$` and a backslash literal.
//
// ```novo
// use dotenvwrite
//
// fn main() [io]
//     match dotenvwrite.quoting_for("it's")
//         DotenvDoubleQuoted => println("double")
//         _                  => println("other")
// ```
pub fn quoting_for(value: Str) -> DotenvQuoting []
    if not needs_quoting(value)
        return DotenvUnquoted
    if not can_single_quote(value) or has_control(value)
        return DotenvDoubleQuoted
    DotenvSingleQuoted

// Whether a value must be quoted to read back as itself.
//
// True when it holds a space, a tab, a line break, a `#`, a quote, a
// backquote, a `$` or a backslash.  `$` and the backslash are included
// because python-dotenv reads them specially in a bare value.
pub fn needs_quoting(value: Str) -> Bool []
    for i in 0..str.len(value)
        if str.contains(" \t\n\r#'\"`$\\", str.from_byte(str.byte_at_or(value, i, -1)))
            return true
    false

// A value escaped for the inside of double quotes.
//
// A backslash, a double quote and a `$` gain a backslash in front, and
// a newline, a carriage return and a tab become `\n`, `\r` and `\t`.
pub fn escape(value: Str) -> Str []
    var parts: [Str] = []
    var run = 0
    for i in 0..str.len(value)
        let e = escaped_byte(str.byte_at_or(value, i, -1))
        if e != ""
            list.push(parts, str.slice(value, run, i))
            list.push(parts, e)
            run = i + 1
    list.push(parts, str.slice(value, run, str.len(value)))
    str.join(parts, "")

// Whether a value can be written in single quotes: false when it holds a
// single quote, which the format has no way to escape there.
pub fn can_single_quote(value: Str) -> Bool []
    not str.contains(value, "'")

// A template of a document: every comment and blank line kept, and
// every assignment's value emptied.
//
// This is a `.env.example`: the keys and the notes a person needs, and
// none of the secrets.  An assignment keeps its `export` prefix.
pub fn to_template(d: DotenvDocument) -> DotenvDocument []
    with_lines(d, d.lines |> list.map(l => blanked(l)))

// The keys a template assigns that `actual` has no value for, or only an
// empty one, in the template's order.
pub fn missing_against(template: DotenvDocument, actual: [DotenvEntry]) -> [Str] []
    var out: [Str] = []
    for e in dotenvparse.entries_of(template)
        let v = dotenvparse.lookup(actual, e.key) ?? ""
        if v == "" and not list.contains(out, e.key)
            list.push(out, e.key)
    out

// The text one line renders as, before line endings are applied.
fn line_text(l: DotenvLine) -> Str
    match l
        DotenvBlankLine(t)      => t
        DotenvCommentLine(t)    => t
        DotenvAssignmentLine(e) => render_entry(e)
        DotenvSkippedLine(t, _) => t

// A value as it is written in a form.
fn written_value(value: Str, quoting: DotenvQuoting) -> Str
    match quoting
        DotenvUnquoted     => value
        DotenvSingleQuoted => "'${value}'"
        DotenvDoubleQuoted => "\"${escape(value)}\""

// `quoting` when it can hold `value`, and otherwise double quotes.
fn kept_form(quoting: DotenvQuoting, value: Str) -> DotenvQuoting
    match quoting
        DotenvUnquoted     =>
            if needs_quoting(value)
                return quoting_for(value)
            DotenvUnquoted
        DotenvSingleQuoted =>
            if can_single_quote(value)
                return DotenvSingleQuoted
            DotenvDoubleQuoted
        DotenvDoubleQuoted => DotenvDoubleQuoted

// The index in `d.lines` of the last assignment to `key`, or -1.
fn last_assignment(d: DotenvDocument, key: Str) -> Int
    var found = -1
    for i in 0..list.len(d.lines)
        if assigns(d.lines[i], key)
            found = i
    found

// `lines` with the line at `at` replaced by `l`.
fn with_line_at(lines: [DotenvLine], at: Int, l: DotenvLine) -> [DotenvLine]
    var out: [DotenvLine] = []
    for i in 0..list.len(lines)
        if i == at
            list.push(out, l)
        else
            list.push(out, lines[i])
    out

// Whether a value holds a line break or a tab, which only double quotes
// can carry on one line.
fn has_control(value: Str) -> Bool
    str.contains(value, "\n") or str.contains(value, "\r") or str.contains(value, "\t")

// Whether a line assigns `key`.
fn assigns(l: DotenvLine, key: Str) -> Bool
    if let DotenvAssignmentLine(e) = l
        return e.key == key
    false

// A line with its value emptied when it is an assignment.
fn blanked(l: DotenvLine) -> DotenvLine
    if let DotenvAssignmentLine(e) = l
        return DotenvAssignmentLine(DotenvEntry { key: e.key, value: "", quoting: DotenvUnquoted,
            exported: e.exported, line: e.line, written: "" })
    l

// A comment's text with `# ` in front when it lacks a `#`.
fn comment_text(text: Str) -> Str
    if str.starts_with(str.trim_start(text), "#")
        return text
    "# " + text

// `d` with one more line at the end.
fn appended(d: DotenvDocument, l: DotenvLine) -> DotenvDocument
    var lines = list.clone(d.lines)
    list.push(lines, l)
    with_lines(d, lines)

// `d` with different lines and the same line endings.
fn with_lines(d: DotenvDocument, lines: [DotenvLine]) -> DotenvDocument
    DotenvDocument { lines: lines, newline: d.newline, final_newline: d.final_newline }

// The escape a byte needs inside double quotes, or `""` for none.
fn escaped_byte(b: Int) -> Str
    if b == '\n'
        return "\\n"
    if b == '\r'
        return "\\r"
    if b == '\t'
        return "\\t"
    if b == '\\' or b == '"' or b == '$'
        return "\\" + str.from_byte(b)
    ""
