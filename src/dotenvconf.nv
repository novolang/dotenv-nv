// dotenvconf.nv — a `.env` file's assignments as a config-core-nv layer.
//
// Every row is `[]`.
//
// A `.env` file is flat and a configuration is a tree.  config-core-nv's
// `EnvKeyRule` already says how a name such as `MYAPP__DB__HOST` becomes
// the path `db.host`: a prefix, a separator for the dots, and whether
// segments are lowercased.  This module hands the file's pairs to that
// rule and adds nothing of its own, so a layer built here equals the
// layer config-core-nv builds from the same pairs.
//
// Values stay strings unless the caller asks.  A `.env` file has no
// types, and a guess turns `VERSION=1.10` into the number 1.1.
// `layer_of_inferred` applies config-core-nv's `infer_scalar` by name.
//
// Where the layer sits among a program's other sources is the rank the
// caller passes.

use std.str
use std.list
use cfgenvkeys
use dotenvparse
use dotenvwrite

// A layer of string values from a file's entries.
//
// The rule maps each key to a path, and a key it does not map is left
// out.  The rule's own `infer_scalars` is not consulted.
//
// ```novo
// use dotenvconf
// use dotenvparse
//
// fn main() [io]
//     let r = dotenvconf.rule_for("MYAPP")
//     let l = dotenvconf.layer_of(r, [dotenvparse.entry("MYAPP__DB__HOST", "db1")], ".env", 10)
//     println("${l.rank}")
// ```
pub fn layer_of(rule: EnvKeyRule, entries: [DotenvEntry], name: Str, rank: Int) -> ConfigLayer []
    cfgenvkeys.layer_from(inferring(rule, false), pairs(entries), name, rank)

// A layer with config-core-nv's scalar inference applied, so that
// `PORT=8080` is an integer and `DEBUG=true` a boolean.
pub fn layer_of_inferred(rule: EnvKeyRule, entries: [DotenvEntry], name: Str,
                         rank: Int) -> ConfigLayer []
    cfgenvkeys.layer_from(inferring(rule, true), pairs(entries), name, rank)

// The tree `layer_of` would hold, without the layer around it.
pub fn value_of(rule: EnvKeyRule, entries: [DotenvEntry]) -> ConfigValue []
    layer_of(rule, entries, "", 0).root

// The `(path, value)` pairs a layer is built from, for the entries the
// rule maps, in order.
pub fn mapped_pairs(rule: EnvKeyRule, entries: [DotenvEntry]) -> [(Str, Str)] []
    var out: [(Str, Str)] = []
    for e in entries
        if let Some(p) = cfgenvkeys.map_name(rule, e.key)
            list.push(out, (p, e.value))
    out

// The `(key, value)` pairs of the entries the rule does not map, which
// a layer leaves out.
pub fn skipped_entries(rule: EnvKeyRule, entries: [DotenvEntry]) -> [(Str, Str)] []
    entries
        |> list.filter(e => cfgenvkeys.map_name(rule, e.key) == None)
        |> list.map(pair_of)

// A fault for each mapped path that config-core-nv's path grammar
// refuses.
//
// `cfgenvkeys.map_name` escapes what it maps, so this is empty for every
// rule config-core-nv builds; it is the check a caller with a rule of
// its own can run.
pub fn bad_entries(rule: EnvKeyRule, entries: [DotenvEntry]) -> [ConfigFault] []
    cfgenvkeys.bad_paths(mapped_pairs(rule, entries))

// config-core-nv's default rule for a program's prefix.
//
// A prefix that does not end in `_` gains the separator `__`, so
// `rule_for("MYAPP")` maps `MYAPP__DB__HOST` to `db.host`.  A prefix
// such as `"APP_"` is used as written.
pub fn rule_for(prefix: Str) -> EnvKeyRule []
    if prefix == "" or str.ends_with(prefix, "_")
        return cfgenvkeys.rule(prefix)
    cfgenvkeys.rule(prefix + "__")

// The config path a key maps to under a rule, or `None`.
pub fn path_for(rule: EnvKeyRule, key: Str) -> ?Str []
    cfgenvkeys.map_name(rule, key)

// The key that sets a config path under a rule, or `None` when the path
// has no spelling as an environment variable name.
//
// A program can print it when a required setting is missing, as a line
// to paste into `.env`.
pub fn key_for(rule: EnvKeyRule, path: Str) -> ?Str []
    cfgenvkeys.name_for(rule, path)

// The keys that set each of a list of paths, leaving out a path with no
// spelling.
pub fn keys_for(rule: EnvKeyRule, paths: [Str]) -> [Str] []
    cfgenvkeys.names_for(rule, paths)

// A template document for the paths a program reads: one commented-out
// `KEY=` line for each path that has a spelling.
//
// ```novo
// use dotenvconf
// use dotenvwrite
//
// fn main() [io]
//     let d = dotenvconf.template_for(dotenvconf.rule_for("MYAPP"), ["db.host"])
//     print(dotenvwrite.render(d))
// ```
pub fn template_for(rule: EnvKeyRule, paths: [Str]) -> DotenvDocument []
    var d = dotenvwrite.empty_document()
    for key in keys_for(rule, paths)
        d = dotenvwrite.append_comment(d, "# ${key}=")
    d

// The entries as `(key, value)` pairs.
fn pairs(entries: [DotenvEntry]) -> [(Str, Str)]
    entries |> list.map(pair_of)

// An entry as its `(key, value)` pair.
fn pair_of(e: DotenvEntry) -> (Str, Str)
    (e.key, e.value)

// `rule` with its scalar inference set.
fn inferring(rule: EnvKeyRule, infer: Bool) -> EnvKeyRule
    EnvKeyRule { prefix: rule.prefix,
        separator: rule.separator,
        lowercase: rule.lowercase,
        list_separator: rule.list_separator,
        infer_scalars: infer }
