// dotenvload.nv — the file on disk, the process environment, and the
// policy that decides which of the two wins.
//
// Two effect labels appear here, each for one thing.  `[fs]` reads and
// writes the file.  `[io]` reads the process environment, because that
// is what `std.env` declares: SPEC section 5.1 has no separate label for
// the environment.  Only `environment`, `environment_value` and the two
// `merged` functions carry `[io]`.
//
// This package never sets an environment variable.  Loading a file
// means reading values: `load` answers the file's assignments and
// `merged` answers the values a program should use.  A program that
// takes its configuration as a value can be tested twice in one process.
//
// The override policy is an argument.  `DotenvKeepEnvironment` lets a
// variable already in the environment win over the file, which is what
// dotenvy and python-dotenv do by default and what makes
// `DATABASE_URL=… ./myprogram` override one setting for one run.
// `DotenvFileWins` is for a deployment tool that wrote the file.
//
// `find_upwards` is a separate call from `load`.  A load reads the path
// it is given and never a file in a parent directory.

use std.list
use std.fs
use std.env
use std.path
use dotenvparse
use dotenvwrite

// The name every implementation of this format looks for.
pub const DOTENV_FILE_NAME = ".env"

// The example file's conventional name.
pub const DOTENV_TEMPLATE_NAME = ".env.example"

// What wins when a key is in both the file and the process
// environment.
pub enum DotenvOverride
    // The environment wins, so `FOO=bar ./myprogram` overrides one
    // setting for one run.
    DotenvKeepEnvironment
    // The file wins, for a deployment tool that wrote the file.
    DotenvFileWins

// What a load produced.
pub struct DotenvLoaded
    // The file it came from, or `""` when the entries were combined from
    // values a caller held.
    path: Str
    // The values to use.  From `load`, the file's assignments.  From
    // `merged` and `combine`, the file's assignments with the policy
    // applied, followed by the environment's variables that the file
    // does not assign, with line 0.
    entries: [DotenvEntry]
    // The keys the file assigned that the environment already had, under
    // `DotenvKeepEnvironment`.  A file's value for one of these did not
    // take effect.
    shadowed: [Str]

// What can go wrong loading or saving a file.
pub enum DotenvLoadFault
    // The file is not there, which is the ordinary state of a production
    // host.
    DotenvFileAbsent(path: Str)
    // The file is there and could not be read.
    DotenvFileUnreadable(path: Str)
    // The file could not be written.
    DotenvFileUnwritable(path: Str)
    // The file parsed badly, with the grammar's own fault.
    DotenvParseFault(path: Str, fault: DotenvFault)
    // A file whose permissions let other users read it.  No function in
    // this package answers it; it is here for a caller that refuses such
    // a file after asking `is_world_readable`.
    DotenvFileIsWorldReadable(path: Str)
    // A walk that reached the filesystem root without finding the file.
    DotenvNotFoundUpwards(started_at: Str)

// A file read and parsed.
//
// `[fs]` and nothing else: the environment is not consulted, so a
// reference in the file resolves against the file's earlier lines only.
//
// ```novo
// use dotenvload
// use dotenvparse
//
// fn main() [fs, io]
//     match dotenvload.load("/nonexistent/.env", dotenvparse.default_options())
//         Ok(l)  => println(l.path)
//         Err(e) => println(e.message())
// ```
pub fn load(path: Str, options: DotenvOptions) -> Result<DotenvLoaded, DotenvLoadFault> [fs]
    let d = load_document(path, options)!
    Ok(DotenvLoaded { path: path, entries: dotenvparse.entries_of(d), shadowed: [] })

// A file read and parsed, or `None` when it is not there.
pub fn load_optional(path: Str,
                     options: DotenvOptions) -> Result<?DotenvLoaded, DotenvLoadFault> [fs]
    match load(path, options)
        Ok(l)                    => Ok(Some(l))
        Err(DotenvFileAbsent(_)) => Ok(None)
        Err(f)                   => Err(f)

// A file read as a document, keeping its comments, for a caller that
// will write it back.
pub fn load_document(path: Str,
                     options: DotenvOptions) -> Result<DotenvDocument, DotenvLoadFault> [fs]
    let text = read_text(path)!
    match dotenvparse.parse_document(text, options)
        Ok(d)  => Ok(d)
        Err(f) => Err(DotenvParseFault(path, f))

// A document written to a file, answering `None` when it was written.
//
// The text goes to `<path>.tmp` first and is renamed over the file, so
// a process that dies mid-write leaves the previous file whole.  A file
// that was already there keeps its permissions; a new one is created
// readable by its owner alone.
pub fn save_document(path: Str, d: DotenvDocument) -> ?DotenvLoadFault [fs]
    let tmp = path + ".tmp"
    let mode = fs.file_mode(path) ?? 384
    if not fs.write(tmp, dotenvwrite.render(d))
        return Some(DotenvFileUnwritable(path))
    fs.set_file_mode(tmp, mode)
    if not fs.rename(tmp, path)
        fs.delete(tmp)
        return Some(DotenvFileUnwritable(path))
    None

// The path of the first file called `name` in `start_dir` or one of its
// parents, nearest first.
//
// `start_dir` is made absolute against the working directory before the
// walk.
pub fn find_upwards(start_dir: Str, name: Str) -> Result<Str, DotenvLoadFault> [fs]
    var dir = path.normalize(path.absolute(start_dir))
    while true
        let candidate = path.join(dir, name)
        if fs.is_file(candidate)
            return Ok(candidate)
        let parent = path.dirname(dir)
        if parent == dir or parent == ""
            break
        dir = parent
    Err(DotenvNotFoundUpwards(start_dir))

// Whether a file's permissions let users other than its owner and group
// read it.  False for a file that is not there.
//
// A `.env` holds credentials, so a caller may want to warn about such a
// file.  This package reports it and refuses nothing.
pub fn is_world_readable(path: Str) -> Bool [fs]
    (fs.file_mode(path) ?? 0) % 8 >= 4

// The process environment, as `(name, value)` pairs.
pub fn environment() -> [(Str, Str)] [io]
    env.vars()

// One variable from the process environment.
pub fn environment_value(name: Str) -> ?Str [io]
    env.get(name)

// The values a program should use: a file's and the environment's,
// combined under a policy.
//
// A reference in the file resolves against the file's earlier lines and
// then the environment.  A missing file is `DotenvFileAbsent`.
pub fn merged(path: Str, policy: DotenvOverride,
              options: DotenvOptions) -> Result<DotenvLoaded, DotenvLoadFault> [fs, io]
    let text = read_text(path)!
    let vars = environment()
    match dotenvparse.parse_with(text, options, vars)
        Ok(d)  => Ok(at_path(combine(dotenvparse.entries_of(d), vars, policy), path))
        Err(f) => Err(DotenvParseFault(path, f))

// The same, treating a missing file as a file with no assignments.
//
// ```novo
// use dotenvload
// use dotenvparse
//
// fn main() [fs, io]
//     match dotenvload.merged_optional(".env", DotenvKeepEnvironment, dotenvparse.default_options())
//         Ok(l)  => println(dotenvload.value_of(l, "HOME") ?? "no HOME")
//         Err(e) => println(e.message())
// ```
pub fn merged_optional(path: Str, policy: DotenvOverride,
                       options: DotenvOptions) -> Result<DotenvLoaded, DotenvLoadFault> [fs, io]
    match merged(path, policy, options)
        Err(DotenvFileAbsent(_)) => Ok(at_path(combine([], environment(), policy), path))
        other                    => other

// A file's entries combined with an environment the caller holds.
//
// Under `DotenvKeepEnvironment` an entry whose key the environment has
// takes the environment's value and its key is listed in `shadowed`.
// Under `DotenvFileWins` the entries keep their values.  The
// environment's other variables follow the entries, in its order.
pub fn combine(entries: [DotenvEntry], env: [(Str, Str)], policy: DotenvOverride) -> DotenvLoaded []
    var out: [DotenvEntry] = []
    var shadowed: [Str] = []
    for e in entries
        match env_lookup(env, e.key)
            Some(v) =>
                if keeps_environment(policy)
                    list.push(out, with_value(e, v))
                    if not list.contains(shadowed, e.key)
                        list.push(shadowed, e.key)
                else
                    list.push(out, e)
            None    => list.push(out, e)
    for pr in env
        if dotenvparse.lookup(entries, pr.0) == None
            list.push(out, dotenvparse.entry(pr.0, pr.1))
    DotenvLoaded { path: "", entries: out, shadowed: shadowed }

// The `(key, value)` pairs of a load, in order.
pub fn pairs_of_loaded(l: DotenvLoaded) -> [(Str, Str)] []
    l.entries |> list.map(pair_of)

// A value out of a load, or `None`.
pub fn value_of(l: DotenvLoaded, key: Str) -> ?Str []
    dotenvparse.lookup(l.entries, key)

// The keys whose file value the environment overrode.
pub fn shadowed_keys(l: DotenvLoaded) -> [Str] []
    l.shadowed[:]

// A resolver for `dotenvparse.expand`: a name's last value in `entries`,
// else its value in `env`.
//
// The file's own assignments come first, so a file can build
// `${BASE}/x` out of a line above it.
pub fn resolver_over(entries: [DotenvEntry], env: [(Str, Str)]) -> fn(Str) -> ?Str []
    name => dotenvparse.lookup(entries, name) ?? env_lookup(env, name)

// Every name the entries' values reference that neither the entries nor
// `env` has a value for and that carries no default, each once, in
// order.
pub fn unresolved_in(entries: [DotenvEntry], env: [(Str, Str)]) -> [Str] []
    let resolve = resolver_over(entries, env)
    var out: [Str] = []
    for e in entries
        for name in dotenvparse.unresolved_names(e.value, resolve)
            if not list.contains(out, name)
                list.push(out, name)
    out

// What went wrong loading or saving a file, in one line.
//
// ```novo
// use dotenvload
//
// fn main() [io]
//     println(DotenvFileAbsent(".env").message())
// ```
impl Error for DotenvLoadFault
    fn message(self) -> Str
        match self
            DotenvFileAbsent(p)          => "${p}: there is no such file"
            DotenvFileUnreadable(p)      => "${p}: the file could not be read"
            DotenvFileUnwritable(p)      => "${p}: the file could not be written"
            DotenvParseFault(p, f)       => "${p}: ${f.message()}"
            DotenvFileIsWorldReadable(p) => "${p}: other users can read the file"
            DotenvNotFoundUpwards(s)     => "no file found in ${s} or any directory above it"

// A file's text, or the fault that explains why there is none.
fn read_text(path: Str) -> Result<Str, DotenvLoadFault> [fs]
    match fs.read(path)
        Some(t) => Ok(t)
        None    =>
            if fs.exists(path)
                return Err(DotenvFileUnreadable(path))
            Err(DotenvFileAbsent(path))

// The last value `env` holds for `name`.
fn env_lookup(env: [(Str, Str)], name: Str) -> ?Str
    var found: ?Str = None
    for pr in env
        if pr.0 == name
            found = Some(pr.1)
    found

// An entry with another value, rendered from its fields from now on.
fn with_value(e: DotenvEntry, v: Str) -> DotenvEntry
    DotenvEntry { key: e.key,
        value: v,
        quoting: e.quoting,
        exported: e.exported,
        line: e.line,
        written: "" }

// An entry as its `(key, value)` pair.
fn pair_of(e: DotenvEntry) -> (Str, Str)
    (e.key, e.value)

// A load with its path set.
fn at_path(l: DotenvLoaded, p: Str) -> DotenvLoaded
    DotenvLoaded { path: p, entries: l.entries, shadowed: l.shadowed }

// Whether a policy gives a key to the environment.
fn keeps_environment(policy: DotenvOverride) -> Bool
    match policy
        DotenvKeepEnvironment => true
        DotenvFileWins        => false
