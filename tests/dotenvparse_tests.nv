// dotenvparse_tests.nv — the three value forms, the comment that is
// sometimes part of a value, interpolation, and the faults.
//
// `\$` is written escaped throughout, because a bare `$` before a
// brace in a novo-lang string interpolates the test's own scope.

use std.test
use std.list
use dotenvparse
use dotenvwrite
use dotenvconf
use cfgvalue

fn nothing_resolves(name: Str) -> ?Str
    None

fn home_resolves(name: Str) -> ?Str
    if name == "HOME"
        Some("/home/ops")
    else
        None

@test
fn test_single_quotes_are_literal_and_double_quotes_are_not() [io]
    // `'a\nb'` is four characters with a backslash in them, and
    // `"a\nb"` is three with a newline.
    let opts = dotenvparse.default_options()

    test.case("a single-quoted backslash-n stays two characters")
    match dotenvparse.parse("A='a\\nb'\n", opts)
        Err(_) => test.fail("that is a well-formed single-quoted value")
        Ok(es) => test.assert_eq(str.len(es[0].value), 4)

    test.case("and a double-quoted one becomes a newline")
    match dotenvparse.parse("A=\"a\\nb\"\n", opts)
        Err(_) => test.fail("that is a well-formed double-quoted value")
        Ok(es) => test.assert_eq(str.len(es[0].value), 3)

    test.case("and the form each was written in is kept")
    match dotenvparse.parse("A='x'\nB=\"y\"\nC=z\n", opts)
        Err(_) => test.fail("three ordinary assignments")
        Ok(es) =>
            match es[0].quoting
                DotenvSingleQuoted => test.assert(true)
                _                  => test.fail("the first is single-quoted")
            match es[2].quoting
                DotenvUnquoted => test.assert(true)
                _              => test.fail("the third is bare")

@test
fn test_a_hash_ends_an_unquoted_value_only_after_whitespace() [io]
    // `PASSWORD=abc#123` is seven characters and `PASSWORD=abc #123` is
    // three.
    test.case("a hash with no space before it is part of the value")
    test.assert_eq(dotenvparse.value_ends_at("abc#123"), 7)

    test.case("and one with a space before it is not")
    test.assert_eq(dotenvparse.value_ends_at("abc #123"), 3)

    test.case("which the parser then agrees with")
    let opts = dotenvparse.default_options()
    match dotenvparse.parse("P=abc#123\n", opts)
        Err(_) => test.fail("that is a legal bare value")
        Ok(es) => test.assert_eq(es[0].value, "abc#123")

@test
fn test_a_quoted_value_keeps_its_hash_whatever_the_spacing() [io]
    // The comment rule belongs to the bare form alone.
    let opts = dotenvparse.default_options()
    match dotenvparse.parse("P=\"abc #123\"\n", opts)
        Err(_) => test.fail("that is a legal double-quoted value")
        Ok(es) =>
            test.case("everything inside the quotes is the value")
            test.assert_eq(es[0].value, "abc #123")

@test
fn test_export_is_a_prefix_and_not_part_of_the_key() [io]
    // The prefix lets a shell `source` the file.
    let opts = dotenvparse.default_options()
    match dotenvparse.parse("export FOO=bar\n", opts)
        Err(_) => test.fail("that is an ordinary assignment")
        Ok(es) =>
            test.case("the key is what a shell would set")
            test.assert_eq(es[0].key, "FOO")

            test.case("and the file's own spelling is remembered for the writer")
            test.assert(es[0].exported)

@test
fn test_interpolation_resolves_through_the_callers_function() [io]
    let opts = dotenvparse.default_options()

    test.case("a name the resolver knows is substituted")
    match dotenvparse.expand("\${HOME}/bin", home_resolves, 1, opts)
        Ok(v)  => test.assert_eq(v, "/home/ops/bin")
        Err(_) => test.fail("HOME resolves")

    test.case("a name it does not know expands to nothing, as a shell does")
    match dotenvparse.expand("x\${NOPE}y", nothing_resolves, 1, opts)
        Ok(v)  => test.assert_eq(v, "xy")
        Err(_) => test.fail("an unknown name is empty, not an error")

    test.case("and a default fills the hole")
    match dotenvparse.expand("\${NOPE:-fallback}", nothing_resolves, 1, opts)
        Ok(v)  => test.assert_eq(v, "fallback")
        Err(_) => test.fail("the default form is part of the grammar")

@test
fn test_an_empty_expansion_is_something_a_caller_can_refuse() [io]
    test.case("what the value referenced")
    let names = dotenvparse.referenced_names("postgres://u:\${DB_PASSWORD}@h/db")
    test.assert_eq(list.len(names), 1)
    test.assert_eq(names[0], "DB_PASSWORD")

    test.case("and which of them nothing answered")
    let missing = dotenvparse.unresolved_names("postgres://u:\${DB_PASSWORD}@h/db",
                                               nothing_resolves)
    test.assert_eq(list.len(missing), 1)

    test.case("a reference's name and its default are read separately")
    test.assert_eq(dotenvparse.name_of_reference("NOPE:-fallback"), "NOPE")
    match dotenvparse.default_of_reference("NOPE:-fallback")
        Some(d) => test.assert_eq(d, "fallback")
        None    => test.fail("that reference has a default")

@test
fn test_circular_interpolation_is_refused_rather_than_looped() [io]
    // A parse resolves against earlier lines only, so it cannot loop.
    // `expand` follows an answer that holds a reference, and stops at
    // `max_expansions`.
    let opts = dotenvparse.default_options()
    test.assert_eq(opts.max_expansions, 32)

    test.case("a parse gives each an empty value")
    match dotenvparse.parse("A=\"\${B}\"\nB=\"\${A}\"\n", opts)
        Ok(es) => test.assert_eq(es[1].value, "")
        Err(_) => test.fail("a reference to a later line is empty")

    test.case("expand over the two refuses")
    let loop_env = [dotenvparse.entry("A", "\${B}"), dotenvparse.entry("B", "\${A}")]
    let over_loop = name => dotenvparse.lookup(loop_env, name)
    match dotenvparse.expand("\${A}", over_loop, 3, opts)
        Ok(_)  => test.fail("that chain never settles")
        Err(e) =>
            test.assert_eq(e, DotenvCircularInterpolation("A", 33))
            test.assert_eq(dotenvparse.fault_line(e), 0)

@test
fn test_every_fault_carries_a_line_number() [io]
    let opts = dotenvparse.default_options()

    test.case("an unterminated quote names its line")
    match dotenvparse.parse("A=ok\nB=\"never closed\n", opts)
        Ok(_)  => test.fail("that quote never closes")
        Err(e) =>
            test.assert_eq(dotenvparse.fault_line(e), 2)

    test.case("a line that is not an assignment is a fault in strict mode")
    match dotenvparse.parse("this is not an assignment\n", opts)
        Ok(_)  => test.fail("strict mode refuses a line it cannot read")
        Err(e) =>
            match e
                DotenvNotAnAssignment(_, _) => test.assert(true)
                _                           => test.fail("the fault names the line's text")

@test
fn test_the_last_assignment_wins_and_both_are_reported() [io]
    let opts = dotenvparse.default_options()
    match dotenvparse.parse("A=first\nA=second\n", opts)
        Err(_) => test.fail("two assignments to one key is legal")
        Ok(es) =>
            test.case("the lookup answers the last")
            match dotenvparse.lookup(es, "A")
                Some(v) => test.assert_eq(v, "second")
                None    => test.fail("A is assigned twice")

            test.case("and both lines are available to a caller that cares")
            test.assert_eq(list.len(dotenvparse.duplicate_keys(es)), 1)

@test
fn test_a_document_round_trips_byte_for_byte() [io]
    let text = "# the database\nDB_HOST=localhost\n\n# mail\n# SMTP_HOST=disabled for now\nSMTP_PORT=587\n"
    let opts = dotenvparse.default_options()

    match dotenvparse.parse_document(text, opts)
        Err(_) => test.fail("that is a well-formed file")
        Ok(d)  =>
            test.case("what was parsed renders back unchanged")
            test.assert_eq(dotenvwrite.render(d), text)

            test.case("and one key changed changes one line")
            match dotenvwrite.set(d, "SMTP_PORT", "2525")
                Err(_) => test.fail("that key is in the document")
                Ok(d2) =>
                    let out = dotenvwrite.render(d2)
                    test.assert(str.contains(out, "# the database"))
                    test.assert(str.contains(out, "# SMTP_HOST=disabled for now"))
                    test.assert(str.contains(out, "SMTP_PORT=2525"))

@test
fn test_the_quoting_is_chosen_by_the_value() [io]
    test.case("a plain value needs no quotes")
    test.assert(not dotenvwrite.needs_quoting("localhost"))
    match dotenvwrite.quoting_for("localhost")
        DotenvUnquoted => test.assert(true)
        _              => test.fail("nothing in that value needs quoting")

    test.case("a value with a dollar in it is single-quoted so it stays literal")
    match dotenvwrite.quoting_for("\$HOME/bin")
        DotenvSingleQuoted => test.assert(true)
        _                  => test.fail("a literal dollar must not be interpolated back")

    test.case("and a value with a single quote in it cannot be")
    test.assert(not dotenvwrite.can_single_quote("it's"))
    match dotenvwrite.quoting_for("it's")
        DotenvDoubleQuoted => test.assert(true)
        _                  => test.fail("the format cannot escape a quote inside single quotes")

@test
fn test_the_writer_surface_is_complete() [io]
    let e = dotenvparse.entry("A", "1")
    test.assert(str.len(dotenvwrite.render_entry(e)) > 0)
    test.assert(str.len(dotenvwrite.render_pairs([("A", "1")])) > 0)
    test.assert(str.len(dotenvwrite.escape("a\nb")) > 0)

    let d0 = dotenvwrite.append_blank(
        dotenvwrite.append_comment(
            dotenvwrite.append(dotenvwrite.empty_document(), e), "# a note"))
    test.assert(str.len(dotenvwrite.render(d0)) > 0)

    match dotenvwrite.set_quoted(d0, "A", "2", DotenvDoubleQuoted)
        Ok(_)  => test.assert(true)
        Err(_) => test.fail("A is in the document")
    match dotenvwrite.annotate(d0, "A", "# why A is what it is")
        Ok(_)  => test.assert(true)
        Err(_) => test.fail("A is in the document")
    match dotenvwrite.comment_out(d0, "A")
        Ok(_)  => test.assert(true)
        Err(_) => test.fail("A is in the document")
    match dotenvwrite.unset(d0, "A")
        Ok(_)  => test.assert(true)
        Err(_) => test.fail("A is in the document")

    test.case("and a template is the keys and the comments without the secrets")
    let template = dotenvwrite.to_template(d0)
    test.assert_eq(list.len(dotenvwrite.missing_against(template, [])), 1)

@test
fn test_the_parse_surface_is_complete() [io]
    let opts = dotenvparse.literal_options()
    test.assert(not opts.interpolate)
    test.assert(opts.max_bytes > 0)

    test.assert(dotenvparse.key_is_valid("DB_HOST"))
    test.assert(not dotenvparse.key_is_valid("2FAST"))

    match dotenvparse.unescape("a\\tb", 1)
        Ok(v)  => test.assert(str.len(v) == 3)
        Err(_) => test.fail("backslash-t is a defined escape")

    let quoted = dotenvparse.entry_quoted("A", "1", DotenvSingleQuoted)
    test.assert_eq(quoted.key, "A")

    match dotenvparse.parse_document("A=1\n", dotenvparse.default_options())
        Err(_) => test.fail("one assignment is a document")
        Ok(d)  =>
            test.assert_eq(list.len(dotenvparse.entries_of(d)), 1)
            test.assert_eq(list.len(dotenvparse.pairs_of(d)), 1)

@test
fn test_the_config_seam_is_one_call() [io]
    let rule = dotenvconf.rule_for("MYAPP")
    let entries = [dotenvparse.entry("MYAPP__DB__HOST", "localhost")]

    test.case("the mapping is inspectable before it is applied")
    match dotenvconf.path_for(rule, "MYAPP__DB__HOST")
        Some(p) => test.assert_eq(p, "db.host")
        None    => test.fail("that key matches the prefix")

    test.case("and it inverts, so a missing setting can be reported as a line to paste")
    match dotenvconf.key_for(rule, "db.host")
        Some(k) => test.assert_eq(k, "MYAPP__DB__HOST")
        None    => test.fail("that path has a spelling")
    test.assert_eq(list.len(dotenvconf.keys_for(rule, ["db.host"])), 1)

    test.case("a key the rule does not match is dropped, and says so")
    let mixed = [dotenvparse.entry("MYAPP__DB__HOST", "localhost"),
                 dotenvparse.entry("PATH", "/usr/bin")]
    test.assert_eq(list.len(dotenvconf.mapped_pairs(rule, mixed)), 1)
    test.assert_eq(list.len(dotenvconf.skipped_entries(rule, mixed)), 1)
    test.assert_eq(list.len(dotenvconf.bad_entries(rule, mixed)), 0)

    test.case("the layer, the value and the inferred form")
    let layer = dotenvconf.layer_of(rule, entries, ".env", 10)
    test.assert_eq(layer.rank, 10)
    test.assert_eq(dotenvconf.layer_of_inferred(rule, entries, ".env", 10).rank, 10)
    match cfgvalue.field(dotenvconf.value_of(rule, entries), "db")
        Some(_) => test.assert(true)
        None    => test.fail("db is a table in the tree")

    test.case("and a template generated from the program's own paths")
    let t = dotenvconf.template_for(rule, ["db.host", "bad-path"])
    test.assert_eq(dotenvwrite.render(t), "# MYAPP__DB__HOST=\n")

@test
fn test_a_parse_that_is_not_strict_keeps_what_it_cannot_read() [io]
    let opts = options_with(false, true, true, 1048576)
    let text = "A=1\nnot an assignment\nB='open\nC=3\n"
    match dotenvparse.parse_document(text, opts)
        Err(_) => test.fail("a parse that is not strict skips the line")
        Ok(d)  =>
            test.case("the readable assignments are there")
            test.assert(dotenvparse.pairs_of(d) == [("A", "1"), ("C", "3")])
            test.case("each skipped line keeps its text and its fault")
            test.assert_eq(d.lines[1], DotenvSkippedLine("not an assignment",
                DotenvNotAnAssignment(2, "not an assignment")))
            test.assert_eq(d.lines[2], DotenvSkippedLine("B='open", DotenvUnterminatedQuote(3, "'")))
            test.case("and the document renders back as it was")
            test.assert_eq(dotenvwrite.render(d), text)

@test
fn test_the_options_limit_what_a_parse_accepts() [io]
    let opts = options_with(true, true, true, 8)
    test.case("a file past the size limit")
    test.assert(dotenvparse.parse("A=123456789\n", opts) == Err(DotenvTooLong(12, 8)))

    let one_line = options_with(true, false, true, 1048576)
    test.case("a quoted value across two lines, when that is refused")
    test.assert(dotenvparse.parse("A=1\nB=\"x\ny\"\n", one_line) == Err(DotenvMultilineNotAllowed(2)))

    let no_export = options_with(true, true, false, 1048576)
    test.case("the export prefix, when that is refused")
    test.assert(dotenvparse.parse("export A=1\n", no_export) == Err(DotenvBadKey(1, "export A")))

@test
fn test_line_endings_and_line_numbers() [io]
    let opts = dotenvparse.default_options()
    match dotenvparse.parse_document("A=1\r\nB=\"x\r\ny\"\r\nC=3", opts)
        Err(_) => test.fail("a file with CRLF endings")
        Ok(d)  =>
            test.case("a CRLF file is read with plain newlines in its values")
            test.assert(dotenvparse.pairs_of(d) == [("A", "1"), ("B", "x\ny"), ("C", "3")])
            test.case("the ending and the missing final newline are kept")
            test.assert_eq(d.newline, "\r\n")
            test.assert(not d.final_newline)
            test.case("a line after a two-line value is numbered from the file")
            test.assert_eq(dotenvparse.entries_of(d)[2].line, 4)

@test
fn test_every_escape_sequence() [io]
    test.assert(dotenvparse.unescape("\\n\\r\\t\\\\\\\"\\'\\$", 1) == Ok("\n\r\t\\\"'\$"))
    test.case("a backslash before anything else is refused with its line")
    test.assert(dotenvparse.unescape("a\\qb", 7) == Err(DotenvBadEscape(7, "\\q")))
    test.assert(dotenvparse.unescape("a\\", 2) == Err(DotenvBadEscape(2, "\\")))
    test.case("unescape leaves a reference alone")
    test.assert(dotenvparse.unescape("\${A}", 1) == Ok("\${A}"))

@test
fn test_expand_follows_a_chain_and_refuses_a_broken_one() [io]
    let opts = dotenvparse.default_options()
    let es = [dotenvparse.entry("ROOT", "/srv"), dotenvparse.entry("BASE", "\${ROOT}/app")]
    let over = name => dotenvparse.lookup(es, name)
    test.case("an answer holding a reference is expanded in turn")
    test.assert(dotenvparse.expand("\${BASE}/bin", over, 1, opts) == Ok("/srv/app/bin"))
    test.case("a reference with no closing brace")
    test.assert(dotenvparse.expand("x\${BASE", over, 4, opts) == Err(DotenvUnterminatedInterpolation(4)))
    test.case("a dollar without a brace is kept")
    test.assert(dotenvparse.expand("\$5 and \$", over, 1, opts) == Ok("\$5 and \$"))

@test
fn test_references_are_read_out_of_a_value() [io]
    test.assert_eq(dotenvparse.referenced_names("\${A}-\${B:-x}-\${C"), ["A", "B"])
    test.assert_eq(dotenvparse.referenced_names("plain"), [])
    test.case("a reference with a default is not unresolved")
    test.assert_eq(dotenvparse.unresolved_names("\${A}\${B:-x}", nothing_resolves), ["A"])
    test.assert_eq(dotenvparse.default_of_reference("A"), None)
    test.assert_eq(dotenvparse.name_of_reference("A"), "A")
    test.assert_eq(dotenvparse.default_of_reference("A:-"), Some(""))

@test
fn test_keys_and_the_end_of_a_bare_value() [io]
    test.assert(dotenvparse.key_is_valid("_A1"))
    test.assert(not dotenvparse.key_is_valid(""))
    test.assert(not dotenvparse.key_is_valid("A-B"))
    test.assert(not dotenvparse.key_is_valid("A.B"))
    test.assert_eq(dotenvparse.value_ends_at(""), 0)
    test.assert_eq(dotenvparse.value_ends_at("#x"), 2)
    test.assert_eq(dotenvparse.value_ends_at("a \t#x"), 1)
    test.assert_eq(dotenvparse.value_ends_at("a  "), 1)

@test
fn test_duplicates_carry_both_lines() [io]
    match dotenvparse.parse("A=1\nB=2\nA=3\nA=4\n", dotenvparse.default_options())
        Err(_) => test.fail("four ordinary assignments")
        Ok(es) =>
            test.assert_eq(dotenvparse.duplicate_keys(es),
                           [DotenvDuplicateKey(3, "A", 1), DotenvDuplicateKey(4, "A", 1)])

@test
fn test_a_parse_with_an_environment_reads_it_after_the_file() [io]
    let env = [("HOST", "env-host"), ("PORT", "1")]
    match dotenvparse.parse_with("PORT=2\nURL=\"\${HOST}:\${PORT}\"\n", dotenvparse.default_options(), env)
        Err(_) => test.fail("two ordinary assignments")
        Ok(d)  => test.assert_eq(dotenvparse.lookup(dotenvparse.entries_of(d), "URL"), Some("env-host:2"))

@test
fn test_every_fault_has_a_message_and_a_line() [io]
    let faults = [DotenvNotAnAssignment(1, "x"),
                  DotenvBadKey(2, "a-b"),
                  DotenvEmptyKey(3),
                  DotenvUnterminatedQuote(4, "\""),
                  DotenvUnterminatedInterpolation(5),
                  DotenvBadEscape(6, "\\q"),
                  DotenvCircularInterpolation("A", 33),
                  DotenvTooLong(10, 8),
                  DotenvMultilineNotAllowed(9),
                  DotenvDuplicateKey(10, "A", 1)]
    test.assert_eq(faults |> list.map(dotenvparse.fault_line), [1, 2, 3, 4, 5, 6, 0, 0, 9, 10])
    test.assert_eq(faults |> list.map(message_of),
                   ["line 1: not an assignment: x",
                    "line 2: 'a-b' is not a legal variable name",
                    "line 3: the assignment has no name",
                    "line 4: the value's \" is never closed",
                    "line 5: a reference has no closing brace",
                    "line 6: \\q is not an escape sequence",
                    "the reference to A did not settle after 33 steps",
                    "the file is 10 bytes, and the limit is 8",
                    "line 9: a value spans lines, and this parse does not allow it",
                    "line 10: A was already assigned on line 1"])

fn message_of(f: DotenvFault) -> Str
    f.message()

// The default options with four of them chosen.
fn options_with(strict: Bool, multiline: Bool, export: Bool, most: Int) -> DotenvOptions
    DotenvOptions { interpolate: true,
        allow_export: export,
        allow_multiline: multiline,
        strict: strict,
        max_bytes: most,
        max_expansions: 32 }
